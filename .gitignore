/ -- large third-party source data: never in git ----------------------------
# GitHub rejects any file over 100 MB and warns over 50 MB.  These are the
# CellTuneDepot / CellTune-demo archives (6.2 GB) and the unpacked depot
# (2.6 GB); both are public and must be fetched from their own archive.
/data/
/*.zip

# -- derived working tree ---------------------------------------------------
# predictions, model caches, the baseline snapshot, agent scratch.  Two small
# verification tools are kept because they are the audit itself.
/work/*
!/work/_preflight.py
!/work/_validate_adviser.py

# -- vendored third-party source and local patch tooling --------------------
# tools/CellSighter/ is third-party code shipped without its own LICENSE file,
# and tools/*.py|*.ps1 is local patch scaffolding: neither belongs in the
# release.  scripts/r51_cellsighter.py is the wrapper the paper describes.
/tools/

# -- internal planning documents -------------------------------------------
/outputs/
/*.docx
!/1020manuscript.docx
!/1022supplementary_NC.docx
/*.docx.tmp*

# -- static figure exports and superseded manuscript drafts ----------------
# Figures are embedded in the two Word deliverables and are regenerated by
# the plotting scripts; the release does not carry duplicate image trees.
/figures/
/figures1010/
/docs/_patch_test.txt
/docs/database_shortlist.md
/docs/mainline_*.md
/docs/manuscript.md
/docs/manuscript_nc.md
/docs/manuscript_nc.new.md
/docs/manuscript_nc.bak_*
/docs/manuscript_nc.md.bak_*
/docs/manuscript_pre_*.md
/docs/propositions.md.bak_*
/docs/supp_tables.md
/docs/submission/abstract_structured.md
/docs/submission/cover_letter.md
/docs/submission/cover_letter_nc.md
/docs/submission/gvhd_delivery_defect.md
/docs/submission/highlights.md
/docs/submission/prospective_cohort_search.md
/docs/submission/summary_paragraph.md
/docs/submission/title_page.md

# copyrighted reference PDF kept only for local layout comparison
/s41467-026-78451-7_reference.pdf

# local API output
/$null

# -- agent scratch at the repo root ----------------------------------------
/_*.py
/_*.ps1
/_*.json
/_*.csv

# -- the five tables over GitHub's 50 MB warning line ------------------------
# Two of them are over the 100 MB hard limit, so they are shipped here as
# byte-exact gzip members (48.9 MB raw-sum -> 38.8 MB); gunzip into place, or
# re-derive with: python -u scripts/run_pipeline.py --only r20_label_ladder,
# r27_fixedseq,r14_targetcal,r34_external,r32_sequential
/experiments/r20_units.csv
/experiments/r27_fixedseq.csv
/experiments/r31_transfer_detail.csv
/experiments/r14_targetcal_ext.csv
/experiments/r32_sequential.csv

# -- python / editor / OS noise --------------------------------------------
__pycache__/
*.pyc
.vscode/
.idea/
.ipynb_checkpoints/
Thumbs.db
desktop.ini
*.tmp
